{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "product-spec-prd",
  "title": "Product Requirements Document",
  "description": "PRD JSON format produced by the product-spec-pipeline skill. Wire-compatible with the RCF PRD schema; do not depend on any external schema registry.",
  "type": "object",
  "required": ["prdId", "productName", "version", "requirements"],
  "properties": {
    "prdId": {
      "type": "string",
      "description": "Unique PRD identifier",
      "pattern": "^PRD-\\d{3,}$"
    },
    "productName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved"]
    },
    "executiveSummary": { "type": "string" },
    "problemStatement": { "type": "string", "minLength": 1 },
    "targetUsers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "inScope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "outOfScope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "objectives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "category", "domain", "priority"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-\\d{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": ["functional", "non-functional", "technical", "security"]
          },
          "domain": { "type": "string", "minLength": 1 },
          "priority": {
            "type": "string",
            "enum": ["must", "should", "could", "wont"]
          },
          "rationale": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "glossary": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
